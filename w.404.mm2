-- =====================================================
-- Script Name : w.404 | MM2 Hub v5.0 (Part 1/4 - Redesigned UI)
-- =====================================================

local ORION_URL = "https://raw.githubusercontent.com/Qanuir/orion-ui/refs/heads/main/source.lua"
local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local GuiService = game:GetService("GuiService")
local Workspace = game:GetService("Workspace")
local VirtualUser = game:GetService("VirtualUser")
local LocalPlayer = Players.LocalPlayer

if not LocalPlayer then return end
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- ล้าง UI เก่าออกอัตโนมัติเมื่อรันใหม่
for _, gui in ipairs(PlayerGui:GetChildren()) do
    if gui.Name == "Orion" or gui.Name == "w404_MiniUI" or gui.Name == "w404_StatusUI" then
        gui:Destroy()
    end
end

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "w404_MiniUI"
screenGui.ResetOnSpawn = false
screenGui.IgnoreGuiInset = true
screenGui.DisplayOrder = 9999
screenGui.Parent = PlayerGui

-- โหลด Orion Library
local loadOk, OrionLib = pcall(function()
    local source = game:HttpGet(ORION_URL)
    local chunk = loadstring(source)
    return chunk()
end)

if not loadOk or not OrionLib then return end

local setupOk, setupError = pcall(function()
    local espEnabled = false
    
    -- ระบบ Aimbot แบบ 2 ปุ่มอิสระ (Mutual Exclusion)
    local aimbotSnapEnabled = false
    local aimbotSilentEnabled = false
    local snapToggleRef, silentToggleRef = nil, nil
    local updatingAimbot = false

    local wallCheckEnabled = true
    local fovVisible = false
    local fovRadius = 150
    local fovColorMode = "สายรุ้ง (เร็ว)"
    local centerDotEnabled = false
    local targetButtonEnabled = false
    
    local flyEnabled = false
    local flySpeed = 50
    local infJumpEnabled = false
    local noclipEnabled = false
    local autoGunEnabled = false

    -- ตัวแปร Fling แบบสวิตช์เปิด/ปิด
    local flingAllEnabled = false
    local flingInnocentEnabled = false
    local flingSheriffEnabled = false
    local flingMurdererEnabled = false

    local espHighlights = {}
    local espBillboards = {}
    local flyConnection = nil
    local infJumpConnection = nil
    local bodyGyro, bodyVel = nil, nil

    local Window = OrionLib:MakeWindow({
        Name = "w.404 | MM2 Hub v5.0",
        HidePremium = false,
        IntroEnabled = false
    })

    -- 🎯 ปุ่มเป้าหมายขนาด 200x200 (กดแล้วจำลองกดยิงจริง)
    local aimButton = Instance.new("TextButton")
    aimButton.Name = "ActionEmojiButton"
    aimButton.Size = UDim2.fromOffset(200, 200)
    aimButton.Position = UDim2.new(0.7, 0, 0.3, 0)
    aimButton.BackgroundColor3 = Color3.fromRGB(15, 25, 45)
    aimButton.BackgroundTransparency = 0.3
    aimButton.Text = "🎯"
    aimButton.TextSize = 80
    aimButton.Visible = false
    aimButton.Active = true
    aimButton.Draggable = true
    aimButton.ZIndex = 20
    aimButton.Parent = screenGui

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(1, 0)
    btnCorner.Parent = aimButton

    local btnStroke = Instance.new("UIStroke")
    btnStroke.Color = Color3.fromRGB(255, 215, 0)
    btnStroke.Thickness = 4
    btnStroke.Parent = aimButton

    aimButton.MouseButton1Click:Connect(function()
        pcall(function()
            local char = LocalPlayer.Character
            local tool = char and char:FindFirstChildOfClass("Tool")
            if tool then
                tool:Activate()
                VirtualUser:Button1Down(Vector2.new(0,0), Workspace.CurrentCamera.CFrame)
                task.wait(0.05)
                VirtualUser:Button1Up(Vector2.new(0,0), Workspace.CurrentCamera.CFrame)
            end
        end)
    end)
-- =====================================================
-- Script Name : w.404 | MM2 Hub v5.0 (Part 2/4)
-- =====================================================

    -- วง FOV
    local fovFrame = Instance.new("Frame")
    fovFrame.Name = "FOVCircle"
    fovFrame.AnchorPoint = Vector2.new(0.5, 0.5)
    fovFrame.Size = UDim2.fromOffset(fovRadius * 2, fovRadius * 2)
    fovFrame.BackgroundTransparency = 1
    fovFrame.Visible = false
    fovFrame.Parent = screenGui

    local fovCorner = Instance.new("UICorner")
    fovCorner.CornerRadius = UDim.new(1, 0)
    fovCorner.Parent = fovFrame

    local fovStroke = Instance.new("UIStroke")
    fovStroke.Color = Color3.fromRGB(255, 255, 150)
    fovStroke.Thickness = 1.5
    fovStroke.Parent = fovFrame

    -- จุดกลางจอ (Center Dot)
    local centerDot = Instance.new("Frame")
    centerDot.Name = "CenterDot"
    centerDot.AnchorPoint = Vector2.new(0.5, 0.5)
    centerDot.Position = UDim2.new(0.5, 0, 0.5, 0)
    centerDot.Size = UDim2.fromOffset(8, 8)
    centerDot.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    centerDot.BorderSizePixel = 0
    centerDot.Visible = false
    centerDot.ZIndex = 25
    centerDot.Parent = screenGui

    local dotCorner = Instance.new("UICorner")
    dotCorner.CornerRadius = UDim.new(1, 0)
    dotCorner.Parent = centerDot

    local dotStroke = Instance.new("UIStroke")
    dotStroke.Color = Color3.fromRGB(0, 0, 0)
    dotStroke.Thickness = 1
    dotStroke.Parent = centerDot

    -- 🔍 ระบบตรวจสอบบทบาท MM2 (เจาะระบบเกมและ Attributes แบบเรียลไทม์)
    local function getPlayerRole(player)
        local role, color = "คนธรรมดา", Color3.fromRGB(46, 204, 113)
        pcall(function()
            local attrRole = player:GetAttribute("Role") or (player.Character and player.Character:GetAttribute("Role"))
            if attrRole == "Murderer" or attrRole == "ฆาตกร" then
                return "ฆาตกร", Color3.fromRGB(255, 30, 30)
            elseif attrRole == "Sheriff" or attrRole == "นายอำเภอ" then
                return "นายอำเภอ", Color3.fromRGB(30, 144, 255)
            elseif attrRole == "Hero" then
                return "ฮีโร่", Color3.fromRGB(241, 196, 15)
            end

            if player.Character then
                local backpack = player:FindFirstChildOfClass("Backpack")
                local char = player.Character
                local hasKnife = char:FindFirstChild("Knife") or (backpack and backpack:FindFirstChild("Knife"))
                local hasGun = char:FindFirstChild("Gun") or char:FindFirstChild("Revolver") or (backpack and (backpack:FindFirstChild("Gun") or backpack:FindFirstChild("Revolver")))
                
                if hasKnife then
                    role, color = "ฆาตกร", Color3.fromRGB(255, 30, 30)
                elseif hasGun then
                    role, color = "นายอำเภอ", Color3.fromRGB(30, 144, 255)
                end
            end
        end)
        return role, color
    end

    -- Tab 1: ระบบต่อสู้ (Combat)
    local combatTab = Window:MakeTab({Name = "⚔️ ระบบต่อสู้", Icon = "rbxassetid://4483345998"})
    combatTab:AddSection({Name = "ระบบล็อกเป้า Aimbot"})

    snapToggleRef = combatTab:AddToggle({
        Name = "🎯 ล็อกเป้าหันตามทันที (Snap Aimbot)",
        Default = false,
        Callback = function(value)
            if updatingAimbot then return end
            updatingAimbot = true
            aimbotSnapEnabled = value
            if value then
                aimbotSilentEnabled = false
                pcall(function() if silentToggleRef and silentToggleRef.Set then silentToggleRef:Set(false) end end)
            end
            updatingAimbot = false
        end
    })

    silentToggleRef = combatTab:AddToggle({
        Name = "🎯 ล็อกกระสุนโดยกล้องไม่หัน (Silent / Tool Lock)",
        Default = false,
        Callback = function(value)
            if updatingAimbot then return end
            updatingAimbot = true
            aimbotSilentEnabled = value
            if value then
                aimbotSnapEnabled = false
                pcall(function() if snapToggleRef and snapToggleRef.Set then snapToggleRef:Set(false) end end)
            end
            updatingAimbot = false
        end
    })

    combatTab:AddSection({Name = "การตั้งค่าเพิ่มเติม"})
    combatTab:AddToggle({
        Name = "ล็อกทะลุกำแพง / ไม่ทะลุ (Wall Check)",
        Default = true,
        Callback = function(value) wallCheckEnabled = value end
    })

    -- Tab 2: การมองเห็น (Visuals / ESP & FOV)
    local visualTab = Window:MakeTab({Name = "👁️ การมองเห็น", Icon = "rbxassetid://4483345998"})
    
    visualTab:AddSection({Name = "ระบบ ESP บทบาทผู้เล่น"})
    visualTab:AddToggle({
        Name = "เปิด ESP (เรียลไทม์ / เจาะระบบเกม)",
        Default = false,
        Callback = function(value)
            espEnabled = value
            if not value then
                for _, h in pairs(espHighlights) do if h then h:Destroy() end end
                for _, b in pairs(espBillboards) do if b then b:Destroy() end end
                espHighlights = {}
                espBillboards = {}
            end
        end
    })

    visualTab:AddSection({Name = "วง FOV & จุดเล็ง"})
    visualTab:AddToggle({
        Name = "แสดงวง FOV",
        Default = false,
        Callback = function(value)
            fovVisible = value
            fovFrame.Visible = value
        end
    })
    visualTab:AddSlider({
        Name = "ขนาดวง FOV",
        Min = 50, Max = 500, Default = 150, Increment = 5,
        Callback = function(value)
            fovRadius = value
            fovFrame.Size = UDim2.fromOffset(value * 2, value * 2)
        end
    })
    visualTab:AddDropdown({
        Name = "สีวง FOV",
        Default = "สายรุ้ง (เร็ว)",
        Options = {"เหลืองอ่อน", "สายรุ้ง (เร็ว)"},
        Callback = function(value) fovColorMode = value end
    })
    visualTab:AddToggle({
        Name = "จุดตรงกลางหน้าจอ (Center Dot)",
        Default = false,
        Callback = function(value)
            centerDotEnabled = value
            centerDot.Visible = value
        end
    })

    -- Tab 6: 🎨 ธีมสี UI (UI Themes)
    local colorTab = Window:MakeTab({Name = "🎨 ธีมสี UI", Icon = "rbxassetid://4483345998"})
    colorTab:AddSection({Name = "เลือกสี UI หลัก (12 สีมาตรฐาน)"})
    
    colorTab:AddDropdown({
        Name = "เลือกสี UI",
        Default = "🔵 น้ำเงินเข้ม (Navy Blue)",
        Options = {
            "🔵 น้ำเงินเข้ม (Navy Blue)", "🔴 แดงสด (Red)", "🟢 เขียว (Green)", "🟡 เหลือง (Yellow)", 
            "🟣 ม่วง (Purple)", "🟠 ส้ม (Orange)", "🩷 ชมพู (Pink)", "🩵 ฟ้า (Cyan)", 
            "🟤 น้ำตาล (Brown)", "⚫ ดำสนิท (Dark Black)", "⚪ เทาอ่อน (Light Gray)", "🤍 ขาวบริสุทธิ์ (Pure White)"
        },
        Callback = function(value)
            pcall(function()
                local targetColor = Color3.fromRGB(30, 40, 70)
                if value:find("แดงสด") then targetColor = Color3.fromRGB(180, 30, 30)
                elseif value:find("เขียว") then targetColor = Color3.fromRGB(30, 120, 50)
                elseif value:find("เหลือง") then targetColor = Color3.fromRGB(180, 150, 20)
                elseif value:find("ม่วง") then targetColor = Color3.fromRGB(100, 30, 140)
                elseif value:find("ส้ม") then targetColor = Color3.fromRGB(200, 100, 20)
                elseif value:find("ชมพู") then targetColor = Color3.fromRGB(200, 80, 120)
                elseif value:find("ฟ้า") then targetColor = Color3.fromRGB(30, 130, 180)
                elseif value:find("น้ำตาล") then targetColor = Color3.fromRGB(100, 60, 40)
                elseif value:find("ดำสนิท") then targetColor = Color3.fromRGB(15, 15, 20)
                elseif value:find("เทาอ่อน") then targetColor = Color3.fromRGB(80, 80, 90)
                elseif value:find("ขาวบริสุทธิ์") then targetColor = Color3.fromRGB(220, 220, 230) end

                for _, gui in ipairs(PlayerGui:GetChildren()) do
                    if gui.Name == "Orion" then
                        for _, desc in ipairs(gui:GetDescendants()) do
                            if desc:IsA("Frame") and desc.Name == "Main" then
                                desc.BackgroundColor3 = targetColor
                            end
                        end
                    end
                end
            end)
        end
    })
-- =====================================================
-- Script Name : w.404 | MM2 Hub v5.0 (Part 3/4)
-- =====================================================

    -- Tab 3: การเคลื่อนไหว (Movement & Fly)
    local moveTab = Window:MakeTab({Name = "🚀 การเคลื่อนไหว", Icon = "rbxassetid://4483345998"})

    moveTab:AddSection({Name = "ระบบปุ่มควบคุมพิเศษ"})
    moveTab:AddToggle({
        Name = "เปิด/ปิด ปุ่มเป้า 🎯 (200x200)",
        Default = false,
        Callback = function(value)
            targetButtonEnabled = value
            aimButton.Visible = value
        end
    })

    moveTab:AddSection({Name = "ระบบบิน (ท่าลอยนิ่ง / ท่าซูเปอร์แมน)"})
    
    -- 🦸‍♂️ ระบบเปิด-ปิดบิน (บินนิ่งๆ ตั้งตรง / ขยับตัวนอนพุ่งแบบซูเปอร์แมน)
    moveTab:AddToggle({
        Name = "เปิดบิน (Fly)",
        Default = false,
        Callback = function(value)
            flyEnabled = value
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            
            if flyEnabled then
                if hrp and hum then
                    hum.PlatformStand = true
                    bodyGyro = Instance.new("BodyGyro")
                    bodyGyro.P = 9e4
                    bodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
                    bodyGyro.CFrame = hrp.CFrame
                    bodyGyro.Parent = hrp
                    
                    bodyVel = Instance.new("BodyVelocity")
                    bodyVel.Velocity = Vector3.zero
                    bodyVel.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                    bodyVel.Parent = hrp
                    
                    flyConnection = RunService.RenderStepped:Connect(function()
                        if not flyEnabled or not hrp or not hum then return end
                        local cam = Workspace.CurrentCamera
                        local moveDir = hum.MoveDirection
                        local velocity = Vector3.zero
                        
                        if moveDir.Magnitude > 0 then
                            velocity = (cam.CFrame.RightVector * moveDir.X + cam.CFrame.LookVector * moveDir.Z) * flySpeed
                        elseif UIS:IsKeyDown(Enum.KeyCode.W) or UIS:IsKeyDown(Enum.KeyCode.Up) then
                            velocity = cam.CFrame.LookVector * flySpeed
                        elseif UIS:IsKeyDown(Enum.KeyCode.S) or UIS:IsKeyDown(Enum.KeyCode.Down) then
                            velocity = -cam.CFrame.LookVector * flySpeed
                        elseif UIS:IsKeyDown(Enum.KeyCode.A) or UIS:IsKeyDown(Enum.KeyCode.Left) then
                            velocity = -cam.CFrame.RightVector * flySpeed
                        elseif UIS:IsKeyDown(Enum.KeyCode.D) or UIS:IsKeyDown(Enum.KeyCode.Right) then
                            velocity = cam.CFrame.RightVector * flySpeed
                        end
                        
                        bodyVel.Velocity = velocity
                        
                        if velocity.Magnitude > 1 then
                            bodyGyro.CFrame = CFrame.new(hrp.Position, hrp.Position + velocity) * CFrame.Angles(math.rad(90), 0, 0)
                        else
                            bodyGyro.CFrame = CFrame.new(hrp.Position, hrp.Position + cam.CFrame.LookVector)
                        end
                    end)
                end
            else
                if flyConnection then flyConnection:Disconnect() flyConnection = nil end
                if bodyGyro then bodyGyro:Destroy() bodyGyro = nil end
                if bodyVel then bodyVel:Destroy() bodyVel = nil end
                if hrp then
                    for _, v in ipairs(hrp:GetChildren()) do
                        if v:IsA("BodyVelocity") or v:IsA("BodyGyro") then v:Destroy() end
                    end
                end
                if hum then
                    hum.PlatformStand = false
                    hum:ChangeState(Enum.HumanoidStateType.GettingUp)
                end
            end
        end
    })

    moveTab:AddSlider({
        Name = "ความเร็วบิน (1-200)",
        Min = 1, Max = 200, Default = 50, Increment = 1,
        Callback = function(value) flySpeed = value end
    })

    moveTab:AddSection({Name = "การเคลื่อนไหวทั่วไป"})
    moveTab:AddToggle({
        Name = "กระโดดอินฟินิตี้ (Inf Jump)",
        Default = false,
        Callback = function(value)
            infJumpEnabled = value
            if infJumpEnabled then
                if not infJumpConnection then
                    infJumpConnection = UIS.JumpRequest:Connect(function()
                        if infJumpEnabled and LocalPlayer.Character then
                            local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                            if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
                        end
                    end)
                end
            else
                if infJumpConnection then
                    infJumpConnection:Disconnect()
                    infJumpConnection = nil
                end
            end
        end
    })

    moveTab:AddSlider({
        Name = "ความสูงกระโดดปกติ (1-100)",
        Min = 1, Max = 100, Default = 50, Increment = 1,
        Callback = function(value)
            local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.UseJumpPower = true
                hum.JumpPower = value
            end
        end
    })

    moveTab:AddToggle({
        Name = "เดินทะลุ (Noclip)",
        Default = false,
        Callback = function(value)
            noclipEnabled = value
            if not noclipEnabled and LocalPlayer.Character then
                for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = true end
                end
            end
        end
    })

    -- Tab 4: ฟังก์ชันเสริม & วาร์ป (Teleport & Utilities)
    local utilTab = Window:MakeTab({Name = "⚙️ ฟังก์ชัน & วาร์ป", Icon = "rbxassetid://4483345998"})
    
    utilTab:AddSection({Name = "ระบบปืน & วาร์ปเก็บปืน"})
    utilTab:AddToggle({
        Name = "วาร์ปไปเก็บปืนอัตโนมัติ (เฉพาะตอนตกพื้น)",
        Default = false,
        Callback = function(value) autoGunEnabled = value end
    })

    utilTab:AddButton({
        Name = "🔫 วาร์ปไปเก็บปืนแล้วกลับจุดเดิมทันที",
        Callback = function()
            pcall(function()
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if not hrp then return end
                
                local originalPos = hrp.CFrame
                local foundGun = false
                
                for _, obj in ipairs(Workspace:GetChildren()) do
                    if obj.Name == "GunDrop" or obj.Name == "RevolverDrop" then
                        foundGun = true
                        if obj:IsA("BasePart") then
                            hrp.CFrame = obj.CFrame
                        elseif obj:IsA("Model") and obj.PrimaryPart then
                            hrp.CFrame = obj.PrimaryPart.CFrame
                        end
                        task.wait(0.1)
                        break
                    end
                end
                
                if foundGun then
                    task.wait(0.15)
                    hrp.CFrame = originalPos
                end
            end)
        end
    })

    utilTab:AddSection({Name = "ระบบวาร์ปหาผู้เล่น"})
    local targetList = {}
    local function getPlayerNames()
        targetList = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then table.insert(targetList, p.Name) end
        end
        return targetList
    end

    local selectedPlayer = ""
    local playerDropdown = utilTab:AddDropdown({
        Name = "รายชื่อผู้เล่น",
        Default = "",
        Options = getPlayerNames(),
        Callback = function(val) selectedPlayer = val end
    })

    utilTab:AddButton({
        Name = "🔄 รีเซ็ตรายชื่อผู้เล่น",
        Callback = function() playerDropdown:Refresh(getPlayerNames()) end
    })

    utilTab:AddButton({
        Name = "🚀 วาร์ปไปหาผู้เล่นที่เลือก",
        Callback = function()
            local target = Players:FindFirstChild(selectedPlayer)
            if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
                LocalPlayer.Character.HumanoidRootPart.CFrame = target.Character.HumanoidRootPart.CFrame
            end
        end
    })

    utilTab:AddSection({Name = "คำสั่งพิเศษ"})
    utilTab:AddButton({
        Name = "⚡ Kill All (เฉพาะฆาตกร)",
        Callback = function()
            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if not root then return end
            local orig = root.CFrame
            
            pcall(function()
                for _, p in ipairs(Players:GetPlayers()) do
                    local role, _ = getPlayerRole(p)
                    if role == "ฆาตกร" and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                        root.CFrame = p.Character.HumanoidRootPart.CFrame + Vector3.new(0, 1, 0)
                        local tool = char:FindFirstChildOfClass("Tool")
                        if tool then tool:Activate() end
                        task.wait(0.12)
                    end
                end
            end)
            
            task.wait(0.1)
            root.CFrame = orig
        end
    })

    -- Tab 5: แกล้งผู้เล่น (Troll / Fling Hub)
    local trollTab = Window:MakeTab({Name = "🌪️ แกล้งผู้เล่น (Fling)", Icon = "rbxassetid://4483345998"})
    
    trollTab:AddSection({Name = "ระบบเตะผู้เล่นออก (สวิตช์เปิด/ปิด พร้อมวาร์ปกลับจุดเดิม)"})
    trollTab:AddToggle({
        Name = "🌪️ เปิด/ปิด เตะทุกคนออกจากแมพ",
        Default = false,
        Callback = function(value) flingAllEnabled = value end
    })
    trollTab:AddToggle({
        Name = "🛡️ เปิด/ปิด เตะคนธรรมดาออกแมพ",
        Default = false,
        Callback = function(value) flingInnocentEnabled = value end
    })
    trollTab:AddToggle({
        Name = "⭐ เปิด/ปิด เตะนายอำเภอออกแมพ",
        Default = false,
        Callback = function(value) flingSheriffEnabled = value end
    })
    trollTab:AddToggle({
        Name = "🔪 เปิด/ปิด เตะฆาตกรออกแมพ",
        Default = false,
        Callback = function(value) flingMurdererEnabled = value end
    })
-- =====================================================
-- Script Name : w.404 | MM2 Hub v5.0 (Part 4/4)
-- =====================================================

    -- 🌪️ ลูปประมวลผล Fling แบบสวิตช์เปิด/ปิด (ปลอดภัย วาร์ปกลับจุดเดิมอัตโนมัติ)
    task.spawn(function()
        while true do
            pcall(function()
                if flingAllEnabled or flingInnocentEnabled or flingSheriffEnabled or flingMurdererEnabled then
                    local char = LocalPlayer.Character
                    local root = char and char:FindFirstChild("HumanoidRootPart")
                    if root then
                        local originalPos = root.CFrame
                        local targetRole = flingAllEnabled and "All" 
                            or (flingInnocentEnabled and "คนธรรมดา") 
                            or (flingSheriffEnabled and "นายอำเภอ") 
                            or (flingMurdererEnabled and "ฆาตกร")
                        
                        for _, p in ipairs(Players:GetPlayers()) do
                            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                                local role, _ = getPlayerRole(p)
                                if targetRole == "All" or role == targetRole then
                                    local targetRoot = p.Character.HumanoidRootPart
                                    local t0 = tick()
                                    while tick() - t0 < 0.2 and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and (flingAllEnabled or flingInnocentEnabled or flingSheriffEnabled or flingMurdererEnabled) do
                                        root.CFrame = targetRoot.CFrame
                                        root.AssemblyLinearVelocity = Vector3.new(400000, 400000, 400000)
                                        root.AssemblyAngularVelocity = Vector3.new(400000, 400000, 400000)
                                        RunService.Heartbeat:Wait()
                                    end
                                end
                            end
                        end
                        root.AssemblyLinearVelocity = Vector3.zero
                        root.AssemblyAngularVelocity = Vector3.zero
                        root.CFrame = originalPos
                    end
                end
            end)
            task.wait(0.1)
        end
    end)

    -- ลูปหลักการทำงานระบบ
    RunService.RenderStepped:Connect(function()
        if fovVisible then
            local camera = Workspace.CurrentCamera
            if camera then
                local pos = UIS.TouchEnabled and (camera.ViewportSize / 2) or (UIS:GetMouseLocation() - GuiService:GetGuiInset())
                fovFrame.Position = UDim2.fromOffset(pos.X, pos.Y)
                if fovColorMode == "สายรุ้ง (เร็ว)" then
                    -- 🌈 วง FOV สีรุ้งแบบหมุนเปลี่ยนสีไวขึ้นตามความต้องการ
                    fovStroke.Color = Color3.fromHSV((os.clock() * 6) % 1, 1, 1)
                else
                    fovStroke.Color = Color3.fromRGB(255, 255, 150)
                end
            end
        end

        -- ระบบ ESP แบบเรียลไทม์ (เจาะระบบเกม)
        if espEnabled then
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character then
                    local char = player.Character
                    local hrp = char:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local roleName, roleColor = getPlayerRole(player)
                        
                        local hl = espHighlights[player]
                        if not hl then
                            hl = Instance.new("Highlight")
                            hl.Parent = char
                            espHighlights[player] = hl
                        end
                        hl.Adornee = char
                        hl.FillColor = roleColor
                        hl.OutlineColor = Color3.new(1, 1, 1)
                        hl.FillTransparency = 0.4

                        local bill = espBillboards[player]
                        if not bill then
                            bill = Instance.new("BillboardGui")
                            bill.Size = UDim2.fromOffset(120, 50)
                            bill.AlwaysOnTop = true
                            bill.StudsOffset = Vector3.new(0, 3, 0)
                            local lbl = Instance.new("TextLabel")
                            lbl.Name = "Info"
                            lbl.Size = UDim2.fromScale(1, 1)
                            lbl.BackgroundTransparency = 1
                            lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
                            lbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                            lbl.TextStrokeTransparency = 0
                            lbl.TextSize = 14
                            lbl.Font = Enum.Font.GothamBold
                            lbl.Parent = bill
                            bill.Parent = char
                            espBillboards[player] = bill
                        end
                        local textLbl = bill:FindFirstChild("Info")
                        if textLbl then textLbl.Text = player.Name .. "\n[" .. roleName .. "]" end
                    end
                end
            end
        end

        -- ระบบ Aimbot (ทำงานตามปุ่มสวิตช์ที่เปิดอยู่แบบอิสระ)
        if aimbotSnapEnabled or aimbotSilentEnabled then
            local camera = Workspace.CurrentCamera
            if camera then
                local center = UIS.TouchEnabled and (camera.ViewportSize / 2) or (UIS:GetMouseLocation() - GuiService:GetGuiInset())
                local closestPart = nil
                local shortestDist = fovRadius

                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                        local rp = p.Character.HumanoidRootPart
                        local hum = p.Character:FindFirstChildOfClass("Humanoid")
                        if not hum or hum.Health > 0 then
                            local canSee = true
                            if wallCheckEnabled then
                                local rayParams = RaycastParams.new()
                                rayParams.FilterType = Enum.RaycastFilterType.Exclude
                                rayParams.FilterDescendantsInstances = {LocalPlayer.Character, camera}
                                local result = Workspace:Raycast(camera.CFrame.Position, rp.Position - camera.CFrame.Position, rayParams)
                                if result and not result.Instance:IsDescendantOf(p.Character) then canSee = false end
                            end

                            if canSee then
                                local screenPos, onScreen = camera:WorldToViewportPoint(rp.Position)
                                if onScreen then
                                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                                    if dist < shortestDist then
                                        shortestDist = dist
                                        closestPart = rp
                                    end
                                end
                            end
                        end
                    end
                end

                if closestPart then
                    if aimbotSnapEnabled then
                        camera.CFrame = CFrame.new(camera.CFrame.Position, closestPart.Position)
                    elseif aimbotSilentEnabled then
                        pcall(function()
                            local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
                            if tool and tool:FindFirstChild("Handle") then
                                tool.Handle.CFrame = CFrame.new(tool.Handle.Position, closestPart.Position)
                            end
                        end)
                    end
                end
            end
        end

        if autoGunEnabled then
            pcall(function()
                for _, obj in ipairs(Workspace:GetChildren()) do
                    if obj.Name == "GunDrop" or obj.Name == "RevolverDrop" then
                        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                            if obj:IsA("BasePart") then
                                LocalPlayer.Character.HumanoidRootPart.CFrame = obj.CFrame
                            elseif obj:IsA("Model") and obj.PrimaryPart then
                                LocalPlayer.Character.HumanoidRootPart.CFrame = obj.PrimaryPart.CFrame
                            end
                        end
                    end
                end
            end)
        end
    end)

    RunService.Stepped:Connect(function()
        if noclipEnabled and LocalPlayer.Character then
            for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end
    end)

    OrionLib:Init()
end)

if not setupOk then
    warn("Error: " .. tostring(setupError))
end
